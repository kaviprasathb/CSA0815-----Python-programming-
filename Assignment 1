
import re, time, random
TITLES = {"dr", "mr", "mrs", "ms", "prof", "shri", "smt"}

def norm_phone(s):
    d = re.sub(r"\D", "", s or "")
    return d[-10:] if len(d) >= 10 else ""

def norm_name(s):
    w = [x for x in re.findall(r"[a-z]+", (s or "").lower()) if x not in TITLES]
    return " ".join(w)

def keys_of(c):
    k = {"n:" + norm_phone(p) for p in c.get("phones", []) if norm_phone(p)}
    k |= {"e:" + e.strip().lower() for e in c.get("emails", []) if e.strip()}
    return k

def merge(contacts):
    recs, index, nid = {}, {}, 0
    for c in contacts:
        keys = keys_of(c)
        hit = {index[k] for k in keys if k in index}
        if hit:
            rid = min(hit)
            for o in hit - {rid}:
                r = recs.pop(o)
                for f in ("names", "phones", "emails"): recs[rid][f] |= r[f]
                for k in {"n:" + p for p in r["phones"]} | {"e:" + e for e in r["emails"]}: index[k] = rid
        else:
            rid = nid; nid += 1
            recs[rid] = {"names": set(), "phones": set(), "emails": set()}
        r = recs[rid]
        if norm_name(c.get("name")): r["names"].add(norm_name(c["name"]))
        r["phones"] |= {norm_phone(p) for p in c.get("phones", []) if norm_phone(p)}
        r["emails"] |= {e.strip().lower() for e in c.get("emails", []) if e.strip()}
        for k in keys: index[k] = rid
    return list(recs.values())

