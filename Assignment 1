def naive_merge(contacts):
    ks = [keys_of(c) for c in contacts]; parent = list(range(len(ks)))
    def find(x):
        while parent[x] != x: parent[x] = parent[parent[x]]; x = parent[x]
        return x
    for i in range(len(ks)):
        for j in range(i + 1, len(ks)):
            if ks[i] & ks[j]: parent[find(i)] = find(j)
    return len({find(i) for i in range(len(ks)) if ks[i]}) + sum(1 for k in ks if not k)

def synth(n):
    random.seed(11); people = max(1, int(n / 2.5))
    nums = ["9%09d" % random.randrange(10**9) for _ in range(people)]
    fmt = [lambda x: x, lambda x: "+91 %s %s" % (x[:5], x[5:]), lambda x: "0" + x, lambda x: "%s-%s" % (x[:5], x[5:])]
    names = ["Dr. Ravi", "ravi kumar", "Meena S", "Arun", "Priya R", "Mr. Karthik"]
    out = []
    for _ in range(n):
        p = random.randrange(people)
        out.append({"name": random.choice(names), "phones": [random.choice(fmt)(nums[p])], "emails": []})
    return out, people

print("\n%9s %14s %16s %16s" % ("contacts", "merged records", "dict merge ms", "pairwise ms"))
for n in (1000, 4000, 100000):
    C, people = synth(n)
    s = time.perf_counter(); r = merge(C); t1 = time.perf_counter() - s
    if n <= 4000:
        s = time.perf_counter(); k = naive_merge(C); t2 = time.perf_counter() - s
        assert k == len(r); p = "%.1f" % (t2 * 1e3)
    else:
        p = "~%.0f s (est.)" % (t2 / (4000**2) * n**2)
    print("%9d %14d %16.1f %16s" % (n, len(r), t1 * 1e3, p))
