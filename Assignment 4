    'festreg/main.py': r'''import os
from .reader import read_department
from .writer import (write_master, write_event_files, write_errors,
                     write_summary)

DEPARTMENTS = ["CSE", "ECE", "MECH", "CIVIL", "IT"]


def run(in_dir, out_dir):
    os.makedirs(out_dir, exist_ok=True)
    seen, errors, master = set(), [], []
    for dept in DEPARTMENTS:
        path = os.path.join(in_dir, dept + ".txt")
        master.extend(read_department(path, seen, errors))
    write_master(os.path.join(out_dir, "master.csv"), master)
    counts = write_event_files(os.path.join(out_dir, "events"), master)
    write_errors(os.path.join(out_dir, "errors.log"), errors)
    write_summary(os.path.join(out_dir, "summary.txt"), len(DEPARTMENTS),
                  len(master), counts, len(errors))
    return master, counts, errors


if __name__ == "__main__":
    import sys
    try:
        run(sys.argv[1] if len(sys.argv) > 1 else "input",
            sys.argv[2] if len(sys.argv) > 2 else "output")
    except OSError as err:              # e.g. output folder not writable
        print("Cannot write reports:", err)
        sys.exit(1)
