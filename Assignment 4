    'festreg/validator.py': r'''from .errors import InvalidRecord


def valid_email(email):
    """String-method-only e-mail check."""
    if email != email.strip() or " " in email or email.count("@") != 1:
        return False
    local, domain = email.split("@")
    if not local or not domain or "." not in domain:
        return False
    if domain.startswith(".") or domain.endswith(".") or ".." in domain:
        return False
    return len(domain.rsplit(".", 1)[1]) >= 2


def parse_line(line):
    """'reg,name,dept,email,ev1;ev2' -> dict, or raise InvalidRecord."""
    parts = [p.strip() for p in line.strip().split(",")]
    if len(parts) != 5:
        raise InvalidRecord(f"expected 5 fields, found {len(parts)}")
    reg, name, dept, email, events = parts
    if not reg.isdigit():
        raise InvalidRecord(f"register number {reg!r} is not numeric")
    if not name:
        raise InvalidRecord("name is empty")
    if not valid_email(email):
        raise InvalidRecord(f"invalid e-mail {email!r}")
    chosen = [e.strip().title() for e in events.split(";") if e.strip()]
    if not chosen:
        raise InvalidRecord("no event chosen")
    return {"reg": reg, "name": name.title(), "dept": dept.upper(),
            "email": email.lower(), "events": chosen}
