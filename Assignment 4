    'festreg/writer.py': r'''import os


def write_master(path, records):
    with open(path, "w", encoding="utf-8") as f:
        f.write("reg,name,dept,email,events\n")
        for r in records:
            f.write(f"{r['reg']},{r['name']},{r['dept']},{r['email']},"
                    f"{';'.join(r['events'])}\n")


def write_event_files(folder, records):
    by_event = {}
    for r in records:
        for ev in r["events"]:
            by_event.setdefault(ev, []).append(r)
    os.makedirs(folder, exist_ok=True)
    for ev, people in by_event.items():
        with open(os.path.join(folder, ev.replace(" ", "_") + ".txt"), "w",
                  encoding="utf-8") as f:
            for r in people:
                f.write(f"{r['reg']},{r['name']},{r['dept']}\n")
    return {ev: len(p) for ev, p in by_event.items()}


def write_errors(path, errors):
    with open(path, "w", encoding="utf-8") as f:
        for src, n, msg in errors:
            f.write(f"{os.path.basename(src)} | line {n} | {msg}\n")


def write_summary(path, files_read, total_lines_ok, counts, n_errors):
    with open(path, "w", encoding="utf-8") as f:
        f.write(f"Files processed : {files_read}\n")
        f.write(f"Clean records   : {total_lines_ok}\n")
        f.write(f"Rejected lines  : {n_errors}\n")
        for ev, n in sorted(counts.items()):
            f.write(f"Event {ev:<10}: {n}\n")
