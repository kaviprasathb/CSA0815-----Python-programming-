    'festreg/reader.py': r'''from .errors import InvalidRecord
from .validator import parse_line


def read_department(path, seen, errors):
    """Yield clean, non-duplicate records from one department file.
    A missing / unreadable file is logged; it never stops the program."""
    try:
        f = open(path, "r", encoding="utf-8")
    except FileNotFoundError:
        errors.append((path, 0, "department file is missing"))
        return
    except PermissionError:
        errors.append((path, 0, "permission denied"))
        return
    with f:
        try:
            for n, line in enumerate(f, 1):
                if not line.strip():
                    continue
                try:
                    rec = parse_line(line)
                except InvalidRecord as err:
                    errors.append((path, n, str(err)))
                    continue
                if rec["reg"] in seen:                       # O(1) average
                    errors.append((path, n, f"duplicate of {rec['reg']}"))
                    continue
                seen.add(rec["reg"])
                yield rec
        except UnicodeDecodeError as err:
            errors.append((path, 0, f"bad encoding: {err.reason}"))
