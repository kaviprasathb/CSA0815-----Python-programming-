def run_tests():
    """Tests for both seasons, two-decimal readings and the 500 L bonus."""
    assert rate_per_litre(4.25, 8.55) == D("33.15")
    assert str(payout(10, 4.25, 8.55)) == "331.50"
    assert str(rate_per_litre(4.25, 8.55, "summer")) == "35.53"
    assert str(payout(10, 4.25, 8.55, "summer")) == "355.30"
    assert str(rate_per_litre(3.47, 8.46)) == "29.76"
    assert str(payout(8.5, 3.47, 8.46)) == "252.96"
    assert str(payout(8.5, 3.47, 8.46, "summer")) == "269.88"
    assert str(payout(12, 3.5, 8.5, "summer")) == "384.00"
    assert str(ten_day_total([(250, 3.5, 8.5), (250, 3.5, 8.5)])[3]) == "15000.00"
    assert str(ten_day_total([(250, 3.5, 8.5), (250.5, 3.5, 8.5)])[3]) == "15265.25"
    assert str(ten_day_total([(250, 3.5, 8.5), (250.5, 3.5, 8.5)], "summer")[3]) == "16266.25"
    assert [season_for_month(x) for x in (3, 4, 6, 7)] == ["regular", "summer", "summer", "regular"]
    print("All 12 tests passed")


def demo():
    print("Season for months 3, 4, 6, 7:", [season_for_month(x) for x in (3, 4, 6, 7)])
    for season in ("regular", "summer"):
        r = rate_per_litre("4.25", "8.55", season)
        print(f"{season:8s} fat 4.25 snf 8.55  rate {r}  10 L pays {payout(10, '4.25', '8.55', season)}")
    entries = [(250, "3.50", "8.50"), (250.5, "3.50", "8.50")]
    litres, pay, b, grand = ten_day_total(entries, "summer")
    print(f"Summer ten-day: litres {litres}, payments {pay}, bonus {b}, grand total {grand}")


if __name__ == "__main__":
    run_tests()
    demo()
